# Copie este arquivo para ".env" e preencha com os dados da sua conexao Oracle
# (visiveis no SQL Developer, na tela de propriedades da conexao).

ORACLE_USER=agendamento_user
ORACLE_PASSWORD=changeme
# Formato: host:porta/service_name (ex: localhost:1521/XEPDB1 no Oracle XE)
ORACLE_DSN=localhost:1521/XEPDB1

# Opcional: ja tem esse valor como default no config.py
NAGER_API_BASE=https://date.nager.at/api/v3

# Opcional: default "true" (modo desenvolvimento). Use "false" para desligar o debug do Flask.
FLASK_DEBUG=true
